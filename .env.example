# AI GarminCoach Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
# Option 1: PostgreSQL (Recommended for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_garmin_coach
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Option 2: SQLite (Simple for development)
# DB_HOST=data/ai_garmin_coach.db
# DB_PORT=0
# DB_NAME=ai_garmin_coach
# DB_USER=
# DB_PASSWORD=

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Gen AI Configuration
GOOGLE_API_KEY=your-google-genai-api-key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BIND_ON_FIRST_START=true
TELEGRAM_UNAUTHORIZED_REPO_URL=https://github.com/GitSergii/Garmin-Coach

# Garmin Connect Credentials
# These will be stored in database per user
GARMIN_USERNAME=your-garmin-username
GARMIN_PASSWORD=your-garmin-password

# Application Configuration
APP_NAME=AI GarminCoach
APP_VERSION=1.0.0
APP_DEBUG=true
APP_PORT=8080

# Security
SECRET_KEY=replace-with-a-long-random-secret

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Cost Management
COST_LIMIT_DAILY=10.0
COST_LIMIT_MONTHLY=300.0
COST_ALERT_THRESHOLD=0.8

# Feature Flags
ENABLE_CHARTS=true
ENABLE_CACHING=true
ENABLE_MONITORING=true 
ENABLE_NL2SQL=true
# Optional: override Gemini model id for ADK path
# COACH_ADK_MODEL=gemini-2.5-flash

# ADK session persistence contract (async driver required).
ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/adk_sessions.db
ADK_SESSION_APP_NAME=garmin_coach_adk
ADK_SESSION_STRICT_STARTUP=true