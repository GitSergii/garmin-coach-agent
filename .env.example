# Garmin Coach — Environment Configuration
# Copy to .env and fill in your values.
# Garmin credentials are NOT stored here — enter them via /setup in Telegram.

# ── Required ──────────────────────────────────────────────────────────────────

# Google Gemini API key (https://aistudio.google.com/)
GOOGLE_API_KEY=your-google-genai-api-key

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Long random string used to encrypt Garmin credentials at rest
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# ── PostgreSQL ─────────────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_NAME=garmin_coach
DB_USER=garmin_coach
DB_PASSWORD=change-me

# ── Access Control ─────────────────────────────────────────────────────────────
# Optional but recommended for production: pre-bind the owner before
# making your bot username public. Get your Telegram user ID from @userinfobot.

TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BIND_ON_FIRST_START=true

# URL shown to unauthorized users. Change to your fork URL.
TELEGRAM_UNAUTHORIZED_REPO_URL=https://github.com/GitSergii/Garmin-Coach

# ── ADK Session Storage ────────────────────────────────────────────────────────
# Must use an async driver. SQLite is the default for local dev.
# For production with PostgreSQL: postgresql+asyncpg://user:pass@host/dbname

ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/adk_sessions.db
ADK_SESSION_APP_NAME=garmin_coach_adk
ADK_SESSION_STRICT_STARTUP=true

# ── Feature Flags ──────────────────────────────────────────────────────────────

ENABLE_NL2SQL=true
ENABLE_CHARTS=true

# ── Optional Overrides ─────────────────────────────────────────────────────────

# Override the Gemini model used by the ADK agent
# COACH_ADK_MODEL=gemini-2.5-flash

# Application log level
LOG_LEVEL=INFO
